[Unit]
Description=Piticko Bot - zaloha PostgreSQL databaze
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=debian
Group=debian
WorkingDirectory=/home/debian/piticko-bot
ExecStart=/home/debian/piticko-bot/.venv/bin/python /home/debian/piticko-bot/scripts/backup_neon.py
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
