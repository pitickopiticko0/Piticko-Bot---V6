# Discord forum channel, kam se mají nové počítače odesílat.
MAKEJPC_FORUM_CHANNEL_ID=123456789012345678

# Minimálně 5 minut, doporučeno 15.
MAKEJPC_CHECK_INTERVAL_MINUTES=15

# seed = při prvním spuštění pouze uloží současné produkty
# post_all = při prvním spuštění odešle všechny současné produkty
MAKEJPC_FIRST_RUN_MODE=seed

# Volitelné ID role, která se označí u nového produktu. 0 = nikoho neoznačovat.
MAKEJPC_MENTION_ROLE_ID=0

# Kick Developer aplikace: https://dev.kick.com/
KICK_CLIENT_ID=tvuj_kick_client_id
KICK_CLIENT_SECRET=tvuj_kick_client_secret

# Interval kontroly Kick streamů v minutách, minimálně 1.
KICK_CHECK_INTERVAL_MINUTES=5

# Discord OAuth2 pro přihlášení do dashboardu a tlačítko pro přidání bota.
# Client ID není tajné. Client Secret ani TOKEN nikomu neposílej.
DISCORD_CLIENT_ID=tvuj_discord_client_id
DISCORD_CLIENT_SECRET=tvuj_discord_client_secret
DASHBOARD_REDIRECT_URI=https://tvoje-domena.example/auth/callback
DASHBOARD_SECRET_KEY=vygeneruj_dlouhy_nahodny_retezec
# Veřejná HTTPS adresa dashboardu – používá ji příkaz /kolo.
DASHBOARD_PUBLIC_URL=https://tvoje-domena.example

# Volitelné: oprávnění požadovaná v instalačním okně Discordu.
# Výchozí hodnota nepožaduje Administrátora.
BOT_INVITE_PERMISSIONS=1495454051414

# Veřejný HTTPS odkaz na Ko-fi, Buy Me a Coffee, PayPal.Me apod.
# Nezadávej přihlašovací ani tajné platební údaje.
SUPPORT_URL=https://example.com/podpora
